<mjml>
  <mj-body background-color="#fafbfc">
    <mj-section background-color="#fff" padding="40px 20px">
      <mj-column vertical-align="middle" width="100%">
        <mj-text
          align="center"
          padding="35px"
          font-size="20px"
          font-family="Arial, Helvetica, sans-serif"
          color="#333"
          >Password Recovery</mj-text
        >
        <mj-text
          align="center"
          font-size="16px"
          padding-left="25px"
          padding-right="25px"
          font-family="Arial, Helvetica, sans-serif"
          color="#555"
          ><span>Hello {{ username }}</span></mj-text
        >
        <mj-text
          align="center"
          font-size="16px"
          padding-left="25px"
          padding-right="25px"
          font-family="Arial, Helvetica, sans-serif"
          color="#555"
          >We've received a request to reset your password. You can do it by
          clicking the button below:</mj-text
        >
        <mj-button
          align="center"
          font-size="18px"
          background-color="#e0c3fc"
          border-radius="8px"
          color="#333"
          href="{{ link }}"
          padding="15px 30px"
          >Reset password</mj-button
        >
        <mj-text
          align="center"
          font-size="16px"
          padding-left="25px"
          padding-right="25px"
          font-family="Arial, Helvetica, sans-serif"
          color="#555"
          >This password will expire in {{ valid_hours }} hours.</mj-text
        >
        <mj-divider border-color="#ccc" border-width="2px"></mj-divider>
        <mj-text
          align="center"
          font-size="14px"
          padding-left="25px"
          padding-right="25px"
          font-family="Arial, Helvetica, sans-serif"
          color="#555"
          >If you didn't request a password recovery you can disregard this
          email.</mj-text
        >
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
